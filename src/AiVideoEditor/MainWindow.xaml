<Window x:Class="AiVideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Video Editor" Width="1280" Height="800">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
      <Button x:Name="newButton" Content="New" Margin="0,0,6,0" Padding="10,4"/>
      <Button x:Name="openButton" Content="Open…" Margin="0,0,6,0" Padding="10,4"/>
      <Button x:Name="saveButton" Content="Save" Margin="0,0,6,0" Padding="10,4"/>
      <Button x:Name="saveAsButton" Content="Save As…" Margin="0,0,6,0" Padding="10,4"/>
      <Button x:Name="exportButton" Content="Export ffmpeg…" Margin="0,0,6,0" Padding="10,4"/>
      <TextBlock Text="Project:" VerticalAlignment="Center" Margin="12,0,4,0"/>
      <TextBox x:Name="projectNameText" Width="180" VerticalAlignment="Center"/>
      <Button x:Name="checkUpdateButton" Content="Check for updates" Margin="12,0,6,0" Padding="10,4"/>
      <Button x:Name="restartUpdateButton" Content="Restart to update" Margin="0,0,6,0" Padding="10,4"
              Visibility="Collapsed" Background="#FFD9EDD9"/>
    </StackPanel>

    <!-- Global prompt + triage import -->
    <Grid Grid.Row="1" Margin="8,0,8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Project prompt (for the AI, applies to the whole video):" FontWeight="Bold"/>
        <TextBox x:Name="globalPromptText" Height="44" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Import from triage (clip_data.sqlite, read-only):" FontWeight="Bold"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="triageDbText" Margin="0,0,4,0"/>
          <Button x:Name="browseDbButton" Grid.Column="1" Content="Browse…" Padding="8,2"/>
        </Grid>
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="medalRootText" Text="W:\medal" Margin="0,0,4,0"/>
          <Button x:Name="browseMedalButton" Grid.Column="1" Content="Medal root…" Padding="8,2" Margin="0,0,4,0"/>
          <TextBox x:Name="collectionText" Margin="0,0,4,0" ToolTip="Collection name (blank = all kept clips)"/>
          <Button x:Name="importButton" Grid.Column="3" Content="Import" Padding="10,2"/>
        </Grid>
      </StackPanel>
    </Grid>

    <!-- Main: timeline | preview | details -->
    <Grid Grid.Row="2" Margin="8,0,8,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <!-- Timeline -->
      <DockPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" Text="Timeline (in order):" FontWeight="Bold"/>
        <ListBox x:Name="timelineList" DockPanel.Dock="Top" Height="480">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock FontSize="11" Foreground="Gray">
                  <Run Text="{Binding TrimLabel}"/>
                  <Run Text="  "/>
                  <Run Text="{Binding Game}"/>
                </TextBlock>
                <TextBlock Text="{Binding Prompt}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
          <Button x:Name="addVideosButton" Content="Add videos…" Padding="8,4" Margin="0,0,6,6"/>
          <Button x:Name="moveUpButton" Content="↑ Move up" Padding="8,4" Margin="0,0,6,6"/>
          <Button x:Name="moveDownButton" Content="↓ Move down" Padding="8,4" Margin="0,0,6,6"/>
          <Button x:Name="removeButton" Content="Remove" Padding="8,4" Margin="0,0,6,6"/>
          <Button x:Name="splitButton" Content="Split at playhead" Padding="8,4" Margin="0,0,6,6"/>
        </WrapPanel>
      </DockPanel>

      <!-- Preview -->
      <DockPanel Grid.Column="1" Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" Text="Preview:" FontWeight="Bold"/>
        <MediaElement x:Name="preview" DockPanel.Dock="Top" Height="480"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
          <Slider x:Name="positionSlider" Minimum="0" Maximum="1" Value="0"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button x:Name="playPauseButton" Content="Play" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="setInButton" Content="Set In" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="setOutButton" Content="Set Out" Padding="10,4" Margin="0,0,6,0"/>
            <TextBlock x:Name="timeLabel" VerticalAlignment="Center" Text="0.0s / ?"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- Details -->
      <StackPanel Grid.Column="2">
        <TextBlock Text="Selected clip:" FontWeight="Bold"/>
        <TextBlock Text="Source:" Margin="0,6,0,0"/>
        <TextBox x:Name="sourceText" IsReadOnly="True" TextWrapping="Wrap"/>
        <TextBlock Text="Trim In (s):" Margin="0,6,0,0"/>
        <TextBox x:Name="inText" Text="0"/>
        <TextBlock Text="Trim Out (s, 0 = full):" Margin="0,6,0,0"/>
        <TextBox x:Name="outText" Text="0"/>
        <TextBlock Text="Game:" Margin="0,6,0,0"/>
        <TextBox x:Name="gameText" IsReadOnly="True"/>
        <TextBlock Text="Groups:" Margin="0,6,0,0"/>
        <TextBox x:Name="groupsText" IsReadOnly="True"/>
        <TextBlock Text="Note (from triage):" Margin="0,6,0,0"/>
        <TextBox x:Name="noteText" IsReadOnly="True" Height="52" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="Prompt (AI edit instruction for this clip):" Margin="0,6,0,0" FontWeight="Bold"/>
        <TextBox x:Name="promptText" Height="160" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
    </Grid>

    <StatusBar Grid.Row="3">
      <TextBlock x:Name="statusText" Text="Ready."/>
    </StatusBar>
  </Grid>
</Window>
