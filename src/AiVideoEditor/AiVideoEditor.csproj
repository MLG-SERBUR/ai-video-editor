<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AiVideoEditor</AssemblyName>
    <RootNamespace>AiVideoEditor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single NuGet dep: read medal-sorter/triage clip_data.sqlite.
         Everything else is .NET stdlib. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

</Project>
