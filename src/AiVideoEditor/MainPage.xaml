<!-- Simplified UI: one job at a time, top to bottom, same layout on
     every target (phone, desktop, web). Big preview, timeline strip,
     one selected clip's details. Metadata (game/groups) is not shown —
     it still loads from old project files, it just isn't editing UI. -->
<Page x:Class="AiVideoEditor.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:AiVideoEditor"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="12" RowSpacing="8">
    <!-- Top bar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
      <TextBlock Text="AI Video Editor" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="addVideosButton" Content="Add videos" />
      <Button x:Name="openButton" Content="Open" />
      <Button x:Name="saveButton" Content="Save" />
      <Button x:Name="exportButton" Content="Export" />
      <Button x:Name="checkUpdateButton" Content="Check for updates" />
      <Button x:Name="restartUpdateButton" Content="Restart to update" Visibility="Collapsed" />
    </StackPanel>

    <!-- Project -->
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBox x:Name="projectNameText" Header="Project name" PlaceholderText="Untitled" />
      <TextBox x:Name="globalPromptText" Header="Global prompt (applies to every clip)"
               PlaceholderText="e.g. Fast-paced montage, keep game audio low"
               TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="72" />
    </StackPanel>

    <!-- Preview -->
    <Grid Grid.Row="2" RowDefinitions="*,Auto,Auto">
      <MediaPlayerElement x:Name="previewPlayer"
                          AreTransportControlsEnabled="False"
                          Stretch="Uniform" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button x:Name="playPauseButton" Content="Play" />
        <Slider x:Name="positionSlider" Width="300" Minimum="0" Maximum="1" VerticalAlignment="Center" />
        <TextBlock x:Name="timeLabel" Text="0.0s / ?" VerticalAlignment="Center" />
        <Button x:Name="splitButton" Content="Split here" />
      </StackPanel>
      <TextBlock Grid.Row="2" x:Name="statusText" Text="Ready." TextWrapping="Wrap" />
    </Grid>

    <!-- Timeline: tap a clip to select it -->
    <ListView Grid.Row="3" x:Name="timelineList" MaxHeight="180" SelectionMode="Single">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:TimelineClip">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Bind DisplayName}" />
            <TextBlock Text="{x:Bind TrimLabel}" Opacity="0.6" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Selected clip -->
    <ScrollViewer Grid.Row="4" MaxHeight="280" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
        <TextBlock x:Name="sourceText" Text="" TextWrapping="Wrap" Opacity="0.7" />
        <TextBox x:Name="promptText" Header="Prompt for this clip"
                 PlaceholderText="What should the AI do with this clip?"
                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" />
        <TextBox x:Name="noteText" Header="Note" PlaceholderText="What happened in this clip?" />
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="Trim in" VerticalAlignment="Center" />
          <Slider x:Name="inSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="8,0" />
          <TextBlock x:Name="inValueText" Grid.Column="2" Text="0.0s" VerticalAlignment="Center" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="Trim out" VerticalAlignment="Center" />
          <Slider x:Name="outSlider" Grid.Column="1" Minimum="0" Maximum="1" Margin="8,0" />
          <TextBlock x:Name="outValueText" Grid.Column="2" Text="full" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="setInButton" Content="Set in here" />
          <Button x:Name="setOutButton" Content="Set out here" />
          <Button x:Name="moveUpButton" Content="Move up" />
          <Button x:Name="moveDownButton" Content="Move down" />
          <Button x:Name="removeButton" Content="Remove" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
